        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "personal",
              "business",
              "fleet"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "billing_manager",
              "fleet_manager",
              "driver"
            ]
