# Copy to /etc/vtsa-csms/load-balancer.staging.env on the Nginx load balancer.
APP_NODE_1_HOST=CHANGE_ME_APP_SERVER_1_PRIVATE_IP
APP_NODE_2_HOST=CHANGE_ME_APP_SERVER_2_PRIVATE_IP
APP_NODE_HTTP_PORT=8081
APP_NODE_OCPP_PORT=9001
NGINX_HTTP_UPSTREAM_FILE=/etc/nginx/vtsa-upstreams/staging-http.conf
NGINX_OCPP_UPSTREAM_FILE=/etc/nginx/vtsa-upstreams/staging-ocpp.conf
