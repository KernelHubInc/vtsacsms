# Copy to /etc/vtsa-csms/production.env on each application server.
# Replace every CHANGE_ME value. Both production nodes must use identical values.
COMPOSE_PROJECT_NAME=vtsa-csms-production
DEPLOY_ENVIRONMENT=production
IMAGE_TAG=sha-CHANGE_ME_COMMIT_SHA

APP_DOMAIN=CHANGE_ME_PRODUCTION_DOMAIN
APP_SCHEME=https
APP_KEY=CHANGE_ME_BASE64_APP_KEY
APP_HTTP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=80
SESSION_COOKIE=vtsa_production_session
SESSION_SECURE_COOKIE=true

# Only App Server 1 runs the scheduler. Leave blank on App Server 2.
COMPOSE_PROFILES=scheduler

DB_HOST=CHANGE_ME_DATABASE_HOST
DB_PORT=5432
DB_DATABASE=vtsa_production
DB_USERNAME=vtsa_production
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_SSLMODE=require

REDIS_HOST=CHANGE_ME_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=vtsa:production:
OCPP_GATEWAY_REDIS_DB=2
GATEWAY_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@CHANGE_ME_REDIS_HOST:6379/2

MINIO_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY
MINIO_BUCKET=vtsa-production
MINIO_ENDPOINT=http://CHANGE_ME_STORAGE_HOST:9000
MINIO_PUBLIC_URL=https://CHANGE_ME_STORAGE_DOMAIN/vtsa-production

MAIL_SCHEME=smtps
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=CHANGE_ME_FROM_ADDRESS
MAIL_FROM_NAME="VTSA CSMS"

GATEWAY_INTERNAL_API_TOKEN=CHANGE_ME_GATEWAY_TOKEN
GATEWAY_REDIS_KEY_PREFIX=vtsa:production:ocpp
INTEGRATION_EVENT_STREAM=vtsa:production:platform:events:v1
OCPP_CHARGER_REGISTRY_JSON={}
OCPP_ALLOWED_COMMANDS=TriggerMessage,RemoteStartTransaction,RemoteStopTransaction,RequestStartTransaction,RequestStopTransaction
OCPP_DATA_TRANSFER_ALLOWLIST=
OCPP_PUBLIC_BIND_ADDRESS=0.0.0.0
OCPP_PUBLIC_PORT=9000

FEATURE_OCPP=false
FEATURE_REMOTE_CHARGING=false
FEATURE_REAL_PAYMENTS=false
FEATURE_SETTLEMENTS=false
FEATURE_OCPI=false
FEATURE_STORE_LOCATOR=true
FEATURE_INVENTORY=true
FEATURE_MAINTENANCE=true
FEATURE_PROCUREMENT=true
FEATURE_DEMO_MODE=false
FEATURE_SIMULATED_CHARGING=false
FEATURE_SIMULATED_PAYMENTS=false

MAP_PROVIDER_DEFAULT=openstreetmap
MAP_PROVIDER_ADMIN=openstreetmap
MAP_PROVIDER_OPERATOR=openstreetmap
MAP_PROVIDER_USER_WEB=openstreetmap
MAP_PROVIDER_PUBLIC=openstreetmap
MAP_DEFAULT_LATITUDE=14.5995
MAP_DEFAULT_LONGITUDE=120.9842
MAP_DEFAULT_ZOOM=11
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
