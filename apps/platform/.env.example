APP_NAME="Power Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=vtsa_

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr-json
LOG_STACK=stderr-json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vtsa
DB_USERNAME=vtsa
DB_PASSWORD=
DB_SSLMODE=disable

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=vtsa-local

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="local@vtsa.invalid"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=vtsa-local
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/vtsa-local
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Map rendering defaults. OpenStreetMap works without Google credentials.
MAP_PROVIDER_DEFAULT=openstreetmap
MAP_PROVIDER_ADMIN=openstreetmap
MAP_PROVIDER_OPERATOR=openstreetmap
MAP_PROVIDER_USER_WEB=openstreetmap
MAP_PROVIDER_PUBLIC=openstreetmap
MAP_PROVIDER_MOBILE=openstreetmap
MAP_DEFAULT_LATITUDE=14.5995
MAP_DEFAULT_LONGITUDE=120.9842
MAP_DEFAULT_ZOOM=11
MAP_MIN_ZOOM=3
MAP_MAX_ZOOM=19
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"
MAP_TILE_SUBDOMAINS=
MAP_TILE_MAX_NATIVE_ZOOM=19
MAP_MARKER_CLUSTERING=true

# Public browser key. Restrict it by exact HTTP referrers and to Maps JavaScript API.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_MOBILE_READY=false

OCPP_GATEWAY_INTERNAL_URL=http://ocpp-gateway:9000

PAYMENT_PROVIDER=fake
FAKE_PAYMENT_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
STRIPE_TIMEOUT_SECONDS=20
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
OCPP_GATEWAY_INTERNAL_TOKEN=
OCPP_GATEWAY_COMMAND_TIMEOUT_SECONDS=20
CHARGING_START_EXPIRY_SECONDS=120
SEED_DEMO_CURRENCY=
OCPP_GATEWAY_REDIS_URL=
OCPP_GATEWAY_REDIS_DB=0
OCPP_GATEWAY_REDIS_KEY_PREFIX=vtsa:local:ocpp
OCPP_GATEWAY_EVENT_STREAM=vtsa:local:ocpp:events:v1
OCPP_GATEWAY_AUTHORIZATION_STREAM=vtsa:local:ocpp:authorization-requests:v1
OCPP_GATEWAY_CONSUMER_GROUP=vtsa-platform-v1
INTEGRATION_EVENT_STREAM=vtsa:local:platform:events:v1
