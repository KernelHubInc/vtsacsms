# PostgreSQL-only stack for the Hostinger data server.
DATABASE_COMPOSE_PROJECT_NAME=vtsa-csms-database

# Local development uses 127.0.0.1. On Hostinger, use the data server's
# WireGuard address (10.77.0.1 in the documented topology), never 0.0.0.0.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_RANDOM_APP_PASSWORD

# Both databases intentionally use this shared login at the user's request.
POSTGRES_APP_USER=vtsa_app
POSTGRES_PRODUCTION_DATABASE=vtsa_production
POSTGRES_STAGING_DATABASE=vtsa_staging
POSTGRES_DOCKER_NETWORK=vtsa-database
