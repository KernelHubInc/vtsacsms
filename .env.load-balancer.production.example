# Copy to /etc/vtsa-csms/load-balancer.production.env on the Nginx load balancer.
APP_NODE_1_HOST=CHANGE_ME_APP_SERVER_1_PRIVATE_IP
APP_NODE_2_HOST=CHANGE_ME_APP_SERVER_2_PRIVATE_IP
APP_NODE_HTTP_PORT=80
APP_NODE_OCPP_PORT=9000
NGINX_HTTP_UPSTREAM_FILE=/etc/nginx/vtsa-upstreams/production-http.conf
NGINX_OCPP_UPSTREAM_FILE=/etc/nginx/vtsa-upstreams/production-ocpp.conf
