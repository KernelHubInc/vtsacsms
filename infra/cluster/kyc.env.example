# Provision separately as /etc/vtsa-csms/kyc-production.env or kyc-staging.env.
# Every blank value is operator-supplied; never reuse secrets across environments.
KYC_ENVIRONMENT=production
KYC_DEPLOY_HOSTNAME=
KYC_MODE=self_hosted
KYC_INTERNAL_HOST=
KYC_PRIVATE_BIND=
KYC_PRIVATE_PORT=8443
# Space-separated private IPs/CIDRs; include the actual local Docker source range if needed.
KYC_ALLOWED_CIDRS=
KYC_TLS_CERT=
KYC_TLS_KEY=
KYC_CA_BUNDLE=
# Dedicated VPS4 database AND role: vtsa_kyc_production or vtsa_kyc_staging.
# URL-encode credentials. Use sslmode=verify-full&sslrootcert=/run/kyc/ca.pem.
KYC_DATABASE_URL=
KYC_REQUEST_SECRET=
KYC_CALLBACK_SECRET=
KYC_ENCRYPTION_KEY=
# HTTPS Laravel callback; use private DNS/routing, not a public KYC ingress.
KYC_CALLBACK_URL=
KYC_STORAGE=s3
# Private self-hosted S3-compatible storage, e.g. the existing MinIO installation.
KYC_S3_ENDPOINT=
KYC_S3_BUCKET=
KYC_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KYC_RETENTION_DAYS=30
# Read-only models, pinned and accepted before enabling automatic verification.
KYC_MODEL_DIRECTORY=
KYC_PROVIDER_FACTORY=
# Required only for KYC_MODE=self_hosted. Use container paths under /models.
KYC_FACE_DETECTOR_MODEL=
KYC_FACE_DETECTOR_SHA256=
KYC_FACE_RECOGNIZER_MODEL=
KYC_FACE_RECOGNIZER_SHA256=
# Supply thresholds established using accepted evaluation data; no production default.
KYC_FACE_ACCEPT_THRESHOLD=
KYC_FACE_REJECT_THRESHOLD=
# Required for the optical_v1 live camera flow; evaluate thresholds on supported devices.
KYC_LIVENESS_MODEL=
KYC_LIVENESS_SHA256=
KYC_LIVENESS_ACCEPT_THRESHOLD=
KYC_LIVENESS_REJECT_THRESHOLD=
KYC_LIVENESS_CENTER_TOLERANCE=
KYC_LIVENESS_TURN_THRESHOLD=
