#!/usr/bin/env node

const { execFileSync, spawnSync } = require('node:child_process');
const { existsSync } = require('node:fs');
const path = require('node:path');

const repoRoot = execFileSync('git', ['rev-parse', '--show-toplevel'], {
  encoding: 'utf8',
}).trim();

function run(command, args, cwd) {
  const result = spawnSync(command, args, {
    cwd,
    env: process.env,
    stdio: 'inherit',
    windowsHide: true,
  });

  if (result.error) {
    console.error(`Unable to run ${command}: ${result.error.message}`);
    process.exit(1);
  }

  if (result.status !== 0) {
    process.exit(result.status ?? 1);
  }
}

function runNpm(args, cwd) {
  if (process.platform === 'win32') {
    run('cmd.exe', ['/d', '/s', '/c', 'npm.cmd', ...args], cwd);
    return;
  }

  run('npm', args, cwd);
}

const platformRoot = path.join(repoRoot, 'apps', 'platform');
const pint = path.join(platformRoot, 'vendor', 'bin', 'pint');

if (existsSync(pint)) {
  run('php', ['vendor/bin/pint', '--test'], platformRoot);
}

const gatewayRoot = path.join(repoRoot, 'services', 'ocpp-gateway');
const python = process.platform === 'win32'
  ? path.join(gatewayRoot, '.venv', 'Scripts', 'python.exe')
  : path.join(gatewayRoot, '.venv', 'bin', 'python');

if (existsSync(python)) {
  run(python, ['-m', 'ruff', 'check', '.'], gatewayRoot);
  run(python, ['-m', 'ruff', 'format', '--check', '.'], gatewayRoot);
}

const contractsRoot = path.join(repoRoot, 'packages', 'contracts');

if (existsSync(path.join(contractsRoot, 'node_modules'))) {
  runNpm(['run', 'lint'], contractsRoot);
}
