map $http_upgrade $vtsa_connection_upgrade {
    default upgrade;
    '' close;
}

upstream vtsa_production_http {
    least_conn;
    include /etc/nginx/vtsa-upstreams/production-http.conf;
    keepalive 32;
}

upstream vtsa_staging_http {
    least_conn;
    include /etc/nginx/vtsa-upstreams/staging-http.conf;
    keepalive 32;
}

upstream vtsa_production_ocpp {
    least_conn;
    include /etc/nginx/vtsa-upstreams/production-ocpp.conf;
}

upstream vtsa_staging_ocpp {
    least_conn;
    include /etc/nginx/vtsa-upstreams/staging-ocpp.conf;
}

# Terminate TLS in these virtual hosts before enabling either environment.
# Replace both server-name placeholders with DNS names owned by your organization.
server {
    listen 80;
    server_name REPLACE_WITH_PRODUCTION_DOMAIN;

    location / {
        proxy_pass http://vtsa_production_http;
        include /etc/nginx/vtsa-proxy-headers.conf;
    }
}

server {
    listen 80;
    server_name REPLACE_WITH_STAGING_DOMAIN;

    location / {
        proxy_pass http://vtsa_staging_http;
        include /etc/nginx/vtsa-proxy-headers.conf;
    }
}

# Add TLS-enabled OCPP virtual hosts that proxy to vtsa_production_ocpp and
# vtsa_staging_ocpp. They must forward Upgrade/Connection headers and use a
# long proxy_read_timeout appropriate for persistent WebSocket connections.
