# For infra/compose.yaml. Merge into an existing private .env.staging;
# retain its project name, APP_KEY, database, ports and storage credentials.
COMPOSE_PROJECT_NAME=vtsa-csms-staging
APP_NAME="Power Solutions Staging"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.evcspowersolutions.com
APP_KEY=
# Bind behind your HTTPS reverse proxy. Adjust for a separate proxy host.
APP_HTTP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8000
# Set to the reverse proxy IP/CIDR as seen by the container. Required for HTTPS signed links.
TRUSTED_PROXIES=
LOG_LEVEL=info

# Defaults use bundled services. Use existing external DB_HOST/REDIS_HOST if applicable.
POSTGRES_DB=vtsa_staging
POSTGRES_USER=vtsa
POSTGRES_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=vtsa:staging:
SESSION_COOKIE=vtsa_staging_session
SESSION_SECURE_COOKIE=true
MINIO_ROOT_USER=vtsa-staging
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=vtsa-staging

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_URL=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Power Solutions Staging"

MOBILE_API_BASE_URL=https://staging.evcspowersolutions.com
MOBILE_APP_ENVIRONMENT=staging
MOBILE_WEB_BIND_ADDRESS=127.0.0.1
MOBILE_WEB_PORT=3000
DEFAULT_TENANT_ID=01J0000000VTSADEMA00000000
FEATURE_DEMO_MODE=true
FEATURE_REMOTE_CHARGING=false
FEATURE_REAL_PAYMENTS=false
FEATURE_SIMULATED_CHARGING=false
FEATURE_SIMULATED_PAYMENTS=false
FEATURE_OCPP=false
FEATURE_SETTLEMENTS=false
FEATURE_OCPI=false
INTEGRATION_EVENT_STREAM=vtsa:staging:platform:events:v1
