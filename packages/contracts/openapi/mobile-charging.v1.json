{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer prepaid charging",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/mobile/charging/prepare": {
      "post": {
        "summary": "Review connector pricing and a live prepaid spending limit",
        "operationId": "prepareCustomerCharging",
        "tags": [
          "Charging"
        ],
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-owned response. Never cache.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CustomerChargePreparation"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Unknown or inaccessible resource."
          },
          "422": {
            "description": "Validation or charging precondition failed."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "charger_code": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{6,120}$"
                  },
                  "vehicle_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "charger_code"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/v1/mobile/charging-sessions/remote-start": {
      "post": {
        "summary": "Reserve prepaid funds and request physical start",
        "operationId": "startCustomerCharging",
        "tags": [
          "Charging"
        ],
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "202": {
            "description": "Customer-owned response. Never cache.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CustomerChargingSession"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Unknown or inaccessible resource."
          },
          "422": {
            "description": "Validation or charging precondition failed."
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quote_id": {
                    "type": "string"
                  },
                  "connector_id": {
                    "type": "string"
                  },
                  "payment_method_id": {
                    "type": "string",
                    "enum": [
                      "prepaid_wallet"
                    ]
                  }
                },
                "required": [
                  "quote_id",
                  "connector_id",
                  "payment_method_id"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/v1/mobile/charging-sessions/active": {
      "get": {
        "summary": "Recover only the caller's active or unsettled session",
        "operationId": "activeCustomerCharging",
        "tags": [
          "Charging"
        ],
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-owned response. Never cache.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/CustomerChargingSession"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Unknown or inaccessible resource."
          },
          "422": {
            "description": "Validation or charging precondition failed."
          }
        }
      }
    },
    "/api/v1/mobile/charging-sessions": {
      "get": {
        "summary": "Read the caller's charging history",
        "operationId": "listCustomerCharging",
        "tags": [
          "Charging"
        ],
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-owned response. Never cache.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CustomerChargingSession"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "next_cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "next_cursor"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Unknown or inaccessible resource."
          },
          "422": {
            "description": "Validation or charging precondition failed."
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/mobile/charging-sessions/{session}": {
      "get": {
        "summary": "Read one customer-owned session",
        "operationId": "getCustomerCharging",
        "tags": [
          "Charging"
        ],
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-owned response. Never cache.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CustomerChargingSession"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Unknown or inaccessible resource."
          },
          "422": {
            "description": "Validation or charging precondition failed."
          }
        },
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/mobile/charging-sessions/{session}/remote-stop": {
      "post": {
        "summary": "Request physical stop without asserting completion",
        "operationId": "stopCustomerCharging",
        "tags": [
          "Charging"
        ],
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "202": {
            "description": "Customer-owned response. Never cache.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CustomerChargingSession"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Unknown or inaccessible resource."
          },
          "422": {
            "description": "Validation or charging precondition failed."
          }
        },
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160
            }
          }
        ]
      }
    },
    "/api/v1/mobile/charging-sessions/{session}/cancel": {
      "post": {
        "summary": "Cancel a start only before command dispatch",
        "operationId": "cancelCustomerCharging",
        "tags": [
          "Charging"
        ],
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-owned response. Never cache.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CustomerChargingSession"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Unknown or inaccessible resource."
          },
          "422": {
            "description": "Validation or charging precondition failed."
          }
        },
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctumBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CustomerChargingSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "station_id": {
            "type": "string"
          },
          "station_name": {
            "type": "string"
          },
          "connector_id": {
            "type": "string"
          },
          "connector_name": {
            "type": "string"
          },
          "energy_wh": {
            "type": "integer",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "energy_flow_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "current_power_w": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimated_cost_minor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "final_cost_minor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "requested_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "stopped_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_deadline_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "aggregate_version": {
            "type": "integer",
            "minimum": 0
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "anomaly_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payment_state": {
            "type": "string",
            "enum": [
              "authorized",
              "captured",
              "not_required",
              "requires_action"
            ]
          },
          "reserved_budget_minor": {
            "type": "integer",
            "minimum": 0
          },
          "refundable": {
            "type": "boolean"
          },
          "receipt": {
            "type": "null"
          },
          "invoice": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "state",
          "station_id",
          "station_name",
          "connector_id",
          "connector_name",
          "energy_wh",
          "duration_seconds",
          "energy_flow_seconds",
          "current_power_w",
          "currency",
          "estimated_cost_minor",
          "final_cost_minor",
          "requested_at",
          "started_at",
          "stopped_at",
          "start_deadline_at",
          "updated_at",
          "aggregate_version",
          "failure_reason",
          "anomaly_flags",
          "payment_state",
          "reserved_budget_minor",
          "refundable",
          "receipt",
          "invoice"
        ],
        "additionalProperties": false
      },
      "CustomerChargePreparation": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "connector_id": {
                "type": "string"
              },
              "connector_name": {
                "type": "string"
              },
              "connector_standard": {
                "type": "string"
              },
              "maximum_power_w": {
                "type": "integer",
                "minimum": 0
              },
              "station_id": {
                "type": "string"
              },
              "station_name": {
                "type": "string"
              },
              "station_address": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "readiness": {
                "type": "string"
              },
              "status_observed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "connector_id",
              "connector_name",
              "connector_standard",
              "maximum_power_w",
              "station_id",
              "station_name",
              "station_address",
              "readiness",
              "status_observed_at"
            ],
            "additionalProperties": false
          },
          "quote": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "tariff_version_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "tax_inclusive": {
                "type": "boolean"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimension": {
                      "type": "string"
                    },
                    "price_minor": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unit_quantity": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "dimension",
                    "price_minor",
                    "unit_quantity",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "estimated_preauthorization": {
                "type": "object",
                "properties": {
                  "amount_minor": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "PHP"
                    ]
                  }
                },
                "required": [
                  "amount_minor",
                  "currency"
                ],
                "additionalProperties": false
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "tax_rate_basis_points": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "id",
              "tariff_version_id",
              "name",
              "currency",
              "tax_inclusive",
              "lines",
              "estimated_preauthorization",
              "expires_at",
              "tax_rate_basis_points"
            ],
            "additionalProperties": false
          },
          "payment_methods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "prepaid_wallet"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "is_default": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "label",
                "is_default"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target",
          "quote",
          "payment_methods"
        ],
        "additionalProperties": false
      }
    }
  }
}
