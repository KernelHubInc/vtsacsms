# Copy to .env.production on the VPS and replace every CHANGE_ME value.
# This file is a template only. Never commit .env.production.
COMPOSE_PROJECT_NAME=vtsa-csms
IMAGE_TAG=latest

# Public DNS A/AAAA records must point to the VPS before deployment.
APP_DOMAIN=csms.example.com
OCPP_DOMAIN=ocpp.example.com
STORAGE_DOMAIN=storage.example.com
TLS_EMAIL=ops@example.com

APP_KEY=CHANGE_ME_BASE64_APP_KEY
POSTGRES_DB=vtsa
POSTGRES_USER=vtsa
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
MINIO_ROOT_USER=vtsa-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_STORAGE_PASSWORD
MINIO_BUCKET=vtsa-production

# Configure an SMTP provider before enabling user email flows.
MAIL_SCHEME=smtps
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=CHANGE_ME_FROM_ADDRESS
MAIL_FROM_NAME="VTSA CSMS"

# The internal gateway token must be a separate random value.
GATEWAY_INTERNAL_API_TOKEN=CHANGE_ME_GATEWAY_TOKEN
GATEWAY_REDIS_KEY_PREFIX=vtsa:production:ocpp
INTEGRATION_EVENT_STREAM=vtsa:production:platform:events:v1

# Empty registry denies every charger. Inject enrolled charger records on the VPS;
# never commit passwords, Argon2 hashes, certificate fingerprints, or real ULIDs.
OCPP_CHARGER_REGISTRY_JSON={}
OCPP_ALLOWED_COMMANDS=TriggerMessage,RemoteStartTransaction,RemoteStopTransaction,RequestStartTransaction,RequestStopTransaction
OCPP_DATA_TRANSFER_ALLOWLIST=

# Keep high-risk capabilities disabled until their production integrations are approved.
FEATURE_OCPP=false
FEATURE_REMOTE_CHARGING=false
FEATURE_REAL_PAYMENTS=false
FEATURE_SETTLEMENTS=false
FEATURE_OCPI=false
FEATURE_STORE_LOCATOR=true
FEATURE_INVENTORY=true
FEATURE_MAINTENANCE=true
FEATURE_PROCUREMENT=true
FEATURE_DEMO_MODE=false
FEATURE_SIMULATED_CHARGING=false
FEATURE_SIMULATED_PAYMENTS=false

MAP_PROVIDER_DEFAULT=openstreetmap
MAP_PROVIDER_ADMIN=openstreetmap
MAP_PROVIDER_OPERATOR=openstreetmap
MAP_PROVIDER_USER_WEB=openstreetmap
MAP_PROVIDER_PUBLIC=openstreetmap
MAP_DEFAULT_LATITUDE=14.5995
MAP_DEFAULT_LONGITUDE=120.9842
MAP_DEFAULT_ZOOM=11
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"

# Optional, public browser values. Apply HTTP-referrer/API restrictions first.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Local directory on the VPS; copy backups off-host according to the runbook.
BACKUP_DIR=/var/backups/vtsa-csms
