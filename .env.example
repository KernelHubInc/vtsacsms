COMPOSE_PROJECT_NAME=vtsa-csms

# tools/bootstrap.ps1 fills blank values with local-only random credentials.
APP_KEY=
POSTGRES_DB=vtsa
POSTGRES_USER=vtsa
POSTGRES_PASSWORD=
MINIO_ROOT_USER=vtsa-local
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=vtsa-local

# Milestone 1 feature profile. Typed access is provided by FeatureFlags.
FEATURE_OCPP=false
FEATURE_REMOTE_CHARGING=false
FEATURE_REAL_PAYMENTS=false
FEATURE_SETTLEMENTS=false
FEATURE_OCPI=false
FEATURE_STORE_LOCATOR=true
FEATURE_INVENTORY=true
FEATURE_MAINTENANCE=true
FEATURE_PROCUREMENT=true
FEATURE_DEMO_MODE=true
FEATURE_SIMULATED_CHARGING=false
FEATURE_SIMULATED_PAYMENTS=false

# OpenStreetMap is the credential-free local default. All values use provider IDs openstreetmap|google.
MAP_PROVIDER_DEFAULT=openstreetmap
MAP_PROVIDER_ADMIN=openstreetmap
MAP_PROVIDER_OPERATOR=openstreetmap
MAP_PROVIDER_USER_WEB=openstreetmap
MAP_PROVIDER_PUBLIC=openstreetmap
MAP_PROVIDER_MOBILE=openstreetmap
MAP_DEFAULT_LATITUDE=14.5995
MAP_DEFAULT_LONGITUDE=120.9842
MAP_DEFAULT_ZOOM=11
MAP_MIN_ZOOM=3
MAP_MAX_ZOOM=19
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"
MAP_TILE_SUBDOMAINS=
MAP_TILE_MAX_NATIVE_ZOOM=19
MAP_MARKER_CLUSTERING=true

# Optional public browser configuration. Keep blank until the key is HTTP-referrer and API restricted.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_MOBILE_READY=false

# Payment templates are intentionally blank. The platform fake provider is the local default.
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
STRIPE_TIMEOUT_SECONDS=20
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# OCPP gateway values are local templates only. Production secrets/config come from approved injection.
GATEWAY_ENVIRONMENT=local
GATEWAY_REDIS_KEY_PREFIX=vtsa:local:ocpp
INTEGRATION_EVENT_STREAM=vtsa:local:platform:events:v1
GATEWAY_INTERNAL_API_TOKEN=
OCPP_CHARGER_REGISTRY_JSON={}
OCPP_ALLOWED_COMMANDS=TriggerMessage,RemoteStartTransaction,RemoteStopTransaction,RequestStartTransaction,RequestStopTransaction
OCPP_DATA_TRANSFER_ALLOWLIST=
OCPP_REQUIRE_TLS=false
OCPP_TLS_CERTIFICATE_FILE=
OCPP_TLS_PRIVATE_KEY_FILE=
OCPP_TLS_CLIENT_CA_FILE=
OCPP_TLS_REQUIRE_CLIENT_CERT=false
OCPP_TRUSTED_CLIENT_CERTIFICATE_FINGERPRINT_HEADER=
