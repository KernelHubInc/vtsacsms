# Copy to /etc/vtsa-csms/data.env on the data server only.
# Replace every CHANGE_ME value. Never commit the populated file.
COMPOSE_PROJECT_NAME=vtsa-csms-data

# Bind database, Redis, and object storage only to an encrypted private or VPN
# interface reachable from App Server 1 and App Server 2. Never use 0.0.0.0.
DATA_BIND_ADDRESS=CHANGE_ME_ENCRYPTED_INTERFACE_IP
DATA_BACKUP_PATH=/var/backups/vtsa-data

POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
POSTGRES_PRODUCTION_PASSWORD=CHANGE_ME_RANDOM_PRODUCTION_PASSWORD
POSTGRES_STAGING_PASSWORD=CHANGE_ME_RANDOM_STAGING_PASSWORD

REDIS_PRODUCTION_PORT=6379
REDIS_PRODUCTION_PASSWORD=CHANGE_ME_RANDOM_PRODUCTION_PASSWORD
REDIS_STAGING_PORT=6380
REDIS_STAGING_PASSWORD=CHANGE_ME_RANDOM_STAGING_PASSWORD

# Root credentials remain on the data server. Applications use the separate,
# bucket-limited app credentials below.
MINIO_PRODUCTION_API_PORT=9000
MINIO_PRODUCTION_CONSOLE_PORT=9001
MINIO_PRODUCTION_ROOT_USER=CHANGE_ME_PRODUCTION_ROOT_USER
MINIO_PRODUCTION_ROOT_PASSWORD=CHANGE_ME_RANDOM_PRODUCTION_ROOT_PASSWORD
MINIO_PRODUCTION_APP_USER=CHANGE_ME_PRODUCTION_APP_USER
MINIO_PRODUCTION_APP_PASSWORD=CHANGE_ME_RANDOM_PRODUCTION_APP_PASSWORD

MINIO_STAGING_API_PORT=9100
MINIO_STAGING_CONSOLE_PORT=9101
MINIO_STAGING_ROOT_USER=CHANGE_ME_STAGING_ROOT_USER
MINIO_STAGING_ROOT_PASSWORD=CHANGE_ME_RANDOM_STAGING_ROOT_PASSWORD
MINIO_STAGING_APP_USER=CHANGE_ME_STAGING_APP_USER
MINIO_STAGING_APP_PASSWORD=CHANGE_ME_RANDOM_STAGING_APP_PASSWORD
